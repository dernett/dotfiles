<!--
  This is a very simple config file with many options missing. For a complete
  set of options with comments, see docs/rc.xml.all
-->

<labwc_config>

  <core>
    <!-- Auto-enable HDR on capable outputs. Requires the Vulkan backend
         (WLR_RENDERER=vulkan, set in ~/.config/labwc/environment). -->
    <hdr>no</hdr>
  </core>

  <!--
  <theme>
    <name>Clearlooks-3.4</name>
    <cornerRadius>8</cornerRadius>
    <font name="sans" size="10" />
  </theme>
   -->

  <theme>
  <name>FeishinWindows</name>
  <titlebar>
    <layout>icon:iconify,max,close</layout>
    <showTitle>yes</showTitle>
  </titlebar>
  <cornerRadius>0</cornerRadius>
  <dropShadows>no</dropShadows>
  <dropShadowsOnTiled>no</dropShadowsOnTiled>
  <font place="ActiveWindow">
    <name>Inter</name><size>10</size>
  </font>
  <font place="InactiveWindow">
    <name>Inter</name><size>10</size>
  </font>
  </theme>

  <desktops>
    <popupTime>1000</popupTime>
    <names>
      <name>1</name>
      <name>2</name>
      <name>3</name>
      <name>4</name>
    </names>
  </desktops>

  <keyboard>
    <default />
    <!-- Use a different terminal emulator -->
    <keybind key="W-Return">
      <action name="Execute" command="ghostty" />
    </keybind>
    <keybind key="W-R">
      <action name="Execute" command="noctalia msg panel-toggle launcher" />
    </keybind>
    <!--
      Remove a previously defined keybind
      A shorter alternative is <keybind key="W-F4" />
    -->
    <keybind key="W-F4">
      <action name="None" />
    </keybind>

    <!-- Switch to workspace 1 -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <!-- Move focused window to workspace 1 -->
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="no" />
    </keybind>

    <!-- Switch to workspace 2 -->
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <!-- Move focused window to workspace 2 -->
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="no" />
    </keybind>

    <!-- Switch to workspace 3 -->
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <!-- Move focused window to workspace 3 -->
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="no" />
    </keybind>

    <!-- Switch to workspace 4 -->
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <!-- Move focused window to workspace 4 -->
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="no" />
    </keybind>

    <!-- Cycle workspaces -->
    <keybind key="W-S-h">
      <action name="GoToDesktop" to="left" />
    </keybind>
    <keybind key="W-S-l">
      <action name="GoToDesktop" to="right" />
    </keybind>
  </keyboard>

  <mouse>
    <default />
    <!-- Show a custom menu on desktop right click -->
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="some-custom-menu" />
      </mousebind>
    </context>
  </mouse>

</labwc_config>
